@page
@model WebApp.Pages.Catalog.IndexModel
@{
}

<table class="table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Description</th>
            <th>Last Updated</th>
            <th>In Stock</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Strings) 
        {
            <tr>
                <td>-</td>
                <td>-</td>
                <td>@DateTime.Now.ToString()</td>
                <td>@item.Stock</td>
                <td><a asp-page="Item" asp-route-id="@item.Id">View</a></td>
            </tr>
        }
    </tbody>
</table>

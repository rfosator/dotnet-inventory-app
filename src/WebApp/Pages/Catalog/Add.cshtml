@page
@model WebApp.Pages.Catalog.AddModel
@{
    ViewData["Title"] = "Agregar";
}

<form method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3">
        <label class="form-label" asp-for="Product.Name">Nombre del producto</label>
        <input class="form-control" type="text" asp-for="Product.Name"/>
        <span asp-validation-for="Product.Name" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label class="form-label" asp-for="Product.Description">Descripción del producto</label>
        <input class="form-control" type="text" asp-for="Product.Description" />
    </div>
    <div class="mb-3">
        <label class="form-label" asp-for="Product.Price">Precio</label>
        <input class="form-control" type="number" asp-for="Product.Price"/>
        <span asp-validation-for="Product.Price" class="text-danger"></span>
    </div>

    <a class="btn btn-danger" asp-page="Index">Cancelar</a>
    <button class="btn btn-primary" type="submit">Guardar</button>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
